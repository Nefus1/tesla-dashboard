# ─── Server ────────────────────────────────────────────────────────────────────
PORT=4173
# 127.0.0.1 keeps the dashboard private to this machine. To use it from a wall
# tablet or phone, set HOST=0.0.0.0 AND a long random DASHBOARD_ACCESS_TOKEN,
# then open http://<this-machine>:4173/?token=<token> once on each device.
HOST=127.0.0.1
DASHBOARD_ACCESS_TOKEN=
# Skip the token requirement when access is restricted another way (reverse proxy, Docker -p 127.0.0.1:...)
# TRUST_NETWORK=1
# debug | info | warn | error | silent
LOG_LEVEL=info
# Where Trip A and the activity log are stored (default: ./data)
# DATA_DIR=./data
# Force demo data even when Home Assistant is configured
# MOCK=1

# ─── Home Assistant ────────────────────────────────────────────────────────────
# Example: http://homeassistant.local:8123
HA_URL=
# Profile → Security → Long-lived access tokens
HA_TOKEN=
# REST polling interval used only while the WebSocket is unavailable
# POLL_INTERVAL_MS=30000
# Text used by /api/entities to suggest entity ids
HA_ENTITY_SEARCH=tesla,model y

# ─── Vehicle ───────────────────────────────────────────────────────────────────
VEHICLE_NAME=Model Y
VEHICLE_MODEL=Model Y Long Range AWD
# VEHICLE_COLOR=Stealth Grey
# Usable pack size, used to estimate kWh from battery % history
BATTERY_CAPACITY_KWH=75
# Cost per kWh for session/energy cost estimates
ELECTRICITY_RATE=0.15
CURRENCY=USD
# F or C. Normally detected from your sensors' units.
# TEMP_UNIT=F

# ─── Entity mapping ────────────────────────────────────────────────────────────
# Every entity is optional. Unmapped controls are shown as "Not set up" and
# unmapped readings as "—". Find ids at http://127.0.0.1:4173/api/entities
#
# Core
HA_ENTITY_BATTERY=sensor.model_y_battery_level
HA_ENTITY_RANGE=sensor.model_y_battery_range
HA_ENTITY_ODOMETER=sensor.model_y_odometer
HA_ENTITY_LOCK=lock.model_y_lock
HA_ENTITY_LOCATION=device_tracker.model_y_location
HA_ENTITY_SOFTWARE_UPDATE=update.model_y_update

# Charging
HA_ENTITY_CHARGING=switch.model_y_charge
HA_ENTITY_CHARGER_CONNECTED=binary_sensor.model_y_charge_cable
HA_ENTITY_CHARGE_POWER=sensor.model_y_charger_power
HA_ENTITY_CHARGE_RATE=sensor.model_y_charge_rate
HA_ENTITY_CHARGE_LIMIT=number.model_y_charge_limit
HA_ENTITY_ENERGY_ADDED=sensor.model_y_charge_energy_added

# Climate
HA_ENTITY_CLIMATE=climate.model_y_climate
HA_ENTITY_CABIN_TEMP=sensor.model_y_inside_temperature
HA_ENTITY_OUTSIDE_TEMP=sensor.model_y_outside_temperature
HA_ENTITY_DEFROST=switch.model_y_defrost_mode
HA_ENTITY_DEFROST_REAR=
HA_ENTITY_SEAT_HEAT_DRIVER=select.model_y_seat_heater_front_left
HA_ENTITY_SEAT_HEAT_PASSENGER=select.model_y_seat_heater_front_right

# Body & security
HA_ENTITY_FRUNK=cover.model_y_frunk
HA_ENTITY_SENTRY=switch.model_y_sentry_mode
HA_ENTITY_HAZARD=button.model_y_flash_lights

# Scheduled departure
HA_ENTITY_DEPARTURE_ENABLED=
HA_ENTITY_DEPARTURE_TIME=

# ─── Service overrides ─────────────────────────────────────────────────────────
# Services are inferred from the entity domain (lock.lock, switch.turn_on,
# number.set_value, select.select_option, climate.set_temperature, ...).
# Override only when your integration exposes a command differently.
# Format: domain.service
# HA_SERVICE_CHARGING_ON=switch.turn_on
# HA_SERVICE_CHARGING_OFF=switch.turn_off
# HA_SERVICE_LOCK_ON=lock.lock
# HA_SERVICE_LOCK_OFF=lock.unlock
# HA_SERVICE_FRUNK_ON=cover.open_cover
# HA_SERVICE_FRUNK_OFF=cover.close_cover
# HA_SERVICE_CLIMATE_ON=climate.turn_on
# HA_SERVICE_CLIMATE_OFF=climate.turn_off
# HA_SERVICE_DEFROST_ON=switch.turn_on
# HA_SERVICE_DEFROST_OFF=switch.turn_off
# HA_SERVICE_DEFROST_REAR_ON=switch.turn_on
# HA_SERVICE_DEFROST_REAR_OFF=switch.turn_off
# HA_SERVICE_SENTRY_ON=switch.turn_on
# HA_SERVICE_SENTRY_OFF=switch.turn_off
# HA_SERVICE_HAZARD_ON=button.press
# HA_SERVICE_HAZARD_OFF=button.press
# HA_SERVICE_CHARGE_LIMIT=number.set_value
# HA_SERVICE_TARGET_TEMP=climate.set_temperature
# HA_SERVICE_SEAT_HEAT_DRIVER=select.select_option
# HA_SERVICE_SEAT_HEAT_PASSENGER=select.select_option
# HA_SERVICE_DEPARTURE_ENABLED_ON=switch.turn_on
# HA_SERVICE_DEPARTURE_ENABLED_OFF=switch.turn_off
# HA_SERVICE_DEPARTURE_TIME=time.set_value
